# Nokotuber (app desktop) — variáveis de BUILD do frontend (Vite).
# Copie para .env para builds locais, OU defina no ambiente do CI ao gerar os
# instaladores de produção. Só variáveis VITE_* chegam ao bundle.
#
# IMPORTANTE: aqui NÃO entra NENHUM segredo. A URL pública da Store API não é
# segredo. Tokens do Mercado Pago / R2 / DB / JWT ficam SÓ no backend.

# URL pública da Nokotuber Store API.
#  - Dev: deixe em branco ou aponte para o backend local (http://localhost:8080).
#  - Produção: a URL pública do backend no Railway (ex.: https://SEU-APP.up.railway.app).
#
# ATENÇÃO: esta URL também entra na CSP do aplicativo (scripts/csp.mjs). Um
# instalador gerado sem ela sai permitindo só http://localhost:8080 e a Loja é
# bloqueada pela CSP — sem erro visível em `tauri dev`. Sempre gere os builds de
# produção com `pnpm tauri:build` (que roda `pnpm csp:config` antes).
VITE_STORE_API_URL=

# Origens EXTRAS liberadas na CSP, separadas por vírgula. Só precisa quando o
# conteúdo não vem da própria Store API:
#  - base pública do R2 (previews/capas): https://pub-xxxx.r2.dev
#  - endpoint S3 do R2 (URLs assinadas de download): https://<conta>.r2.cloudflarestorage.com
#  - túnel HTTPS ao testar webhook local, se APP_PUBLIC_URL apontar para ele
# Nunca use "*" nem "https:" — a lista é explícita de propósito.
NOKOTUBER_CSP_EXTRA_ORIGINS=
